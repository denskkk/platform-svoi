# ========================================
# СВІЙ ДЛЯ СВОЇХ - Environment Variables
# ========================================

# Database - PostgreSQL
DATABASE_URL="postgresql://username:password@localhost:5432/sviydlyasvoyikh?schema=public"

# JWT Authentication
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"
REFRESH_TOKEN_SECRET="replace-with-a-long-random-refresh-secret"
REFRESH_TOKEN_EXPIRES_IN="30d"

# Application
NODE_ENV="development"
NEXT_PUBLIC_API_URL="http://localhost:3000/api"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
CAPACITOR_SERVER_URL="http://localhost:3000"
PORT="3000"

# File Upload
UPLOAD_MAX_FILE_SIZE="5242880"
ALLOWED_FILE_TYPES="image/jpeg,image/png,image/webp"

# WayForPay configuration
# WAYFORPAY_MERCHANT_ACCOUNT=""
# WAYFORPAY_MERCHANT_SECRET=""
# WAYFORPAY_CURRENCY="UAH"
# WAYFORPAY_SERVICE_URL="https://your-domain.com/api/payments/callback"
# WAYFORPAY_RETURN_URL="https://your-domain.com/payments/checkout"

# Cloudinary for images (optional)
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""

# Email service (optional)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-app-password"
# EMAIL_FROM="noreply@your-domain.com"

# Redis Cache (production optional)
# REDIS_URL="redis://localhost:6379"

# Google Analytics (optional)
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# Monitoring (optional)
# SENTRY_DSN="https://xxx@xxx.ingest.sentry.io/xxx"

# ========================================
# Instructions:
# ========================================
# 1. Copy this file to .env
# 2. Replace all placeholders with real values
# 3. Keep .env local and never commit it
# 4. For production use strong secrets and a real PostgreSQL URL

